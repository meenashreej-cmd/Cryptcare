# Database
DATABASE_URL=mysql+pymysql://cryptcare_user:changeme@localhost:3306/cryptcare

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption (AES-256-GCM key, base64-encoded 32 bytes)
ENCRYPTION_KEY_V1=replace-with-base64-32-byte-key
# Leave unset unless you're mid-rotation — see tests/test_key_rotation.py
ENCRYPTION_KEY_V2=
ACTIVE_ENCRYPTION_KEY_VERSION=v1

# Prescription Signing (Ed25519 - 64 hex chars)
PRESCRIPTION_SIGNING_KEY_HEX=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# OTP (registration/phone verification)
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# MFA (login TOTP — DOCTOR/PHARMACIST/ADMIN)
MFA_ISSUER_NAME=CryptCare
MFA_TOTP_VALID_WINDOW=1

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_SECONDS=300
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_EMERGENCY_ACCESS_MAX=10
RATE_LIMIT_EMERGENCY_ACCESS_WINDOW_SECONDS=300

# Clinical safety (Phase 7)
DRUG_MATCH_SIMILARITY_THRESHOLD=0.55

# Local AI — Ollama (Phase 7 plain-language explanations; never used for the
# blocking decision itself, and its absence never changes the outcome)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_TIMEOUT_SECONDS=3.0
LOCAL_LLM_ENABLED=true

# Email / SMTP (OTP delivery — Phase 1)
# Set SMTP_ENABLED=true and fill in the SMTP_* vars to deliver OTPs by email.
# Gmail example: generate an App Password at
#   https://myaccount.google.com/apppasswords
# (2FA must be on for the Google account first).
# Leave SMTP_ENABLED=false (default) to log the OTP to stdout instead.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-app-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_ADDRESS=your-app-email@gmail.com
SMTP_FROM_NAME=CryptCare

# App
ENV=development
